#!/usr/bin/env bash
# Fast checks on staged files only.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if grep -qE '\.rs$' <<<"$staged"; then
  if ! cargo fmt --all --check; then
    echo "pre-commit: rustfmt failed. Run 'cargo fmt --all' and re-stage." >&2
    exit 1
  fi
fi

if grep -qE '^web/.*\.(ts|tsx|js)$' <<<"$staged"; then
  if ! pnpm -C web lint; then
    echo "pre-commit: web lint failed. Fix the issues above and re-stage." >&2
    exit 1
  fi
fi
